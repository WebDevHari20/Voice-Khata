# One key with both STT and TTS scopes works for Prisma and Timbre.
GNANI_API_KEY=replace-me

# Optional per-service overrides, if you create separate scoped keys.
# GNANI_PRISMA_KEY=replace-me
# GNANI_TIMBRE_KEY=replace-me

GNANI_PRISMA_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TIMBRE_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TIMBRE_MODEL=timbre-v3.0
GNANI_TIMBRE_VOICE=Shivani
GNANI_TIMBRE_LANGUAGE=auto
GEMINI_API_KEY=replace-me
DATABASE_PATH=./backend/data/ledger.db
